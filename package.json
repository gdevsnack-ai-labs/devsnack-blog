{
  "name": "devsnack-blog",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:current && npm run test:audit",
    "test:current": "node --experimental-strip-types src/lib/stockpulse-v1-fixed.test.ts && node --experimental-strip-types src/lib/stockpulse-migration.test.ts",
    "test:audit": "python3 -m unittest scripts/audit_site_test.py scripts/audit_public_content_test.py scripts/audit_source_security_test.py",
    "audit:site": "SITE_URL=https://devsnack-blog.vercel.app python3 scripts/audit_site.py",
    "audit:public-content": "python3 scripts/audit_public_content.py",
    "audit:security": "python3 scripts/audit_source_security.py",
    "audit:links": "python3 scripts/check_internal_links.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
